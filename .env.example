# NecroCode Environment Configuration
# All external keys are optional! NecroCode runs 100% locally and offline out-of-the-box.

# Application Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Google Gemma & Open AI Provider
# Options: "heuristic_local" (default offline), "ollama" (local), "huggingface" (API)
GEMMA_PROVIDER=heuristic_local
GEMMA_MODEL=google/gemma-2-9b-it
OLLAMA_HOST=http://localhost:11434
HUGGINGFACE_TOKEN=

# Sentry Agent Tracing (Partner Category)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# ElevenLabs Spectral Audio (Partner Category)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# MongoDB Atlas Graveyard Vault (Partner Category)
MONGODB_URI=
MONGODB_DATABASE=necrocode_graveyard
